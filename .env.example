# ==============================================================================
# CODESYNC DIGI MARKETING — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit real secrets.
# ==============================================================================

# Public site domain (canonical base URL)
NEXT_PUBLIC_SITE_URL=

# Inquiry Form Delivery Provider ('resend' | 'webhook')
INQUIRY_PROVIDER=

# Resend API credentials (if INQUIRY_PROVIDER=resend)
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# CRM / Webhook integration URL (if INQUIRY_PROVIDER=webhook)
INQUIRY_WEBHOOK_URL=

# Google Analytics / Measurement ID (optional)
NEXT_PUBLIC_GA_ID=

# Development Preview Flags (ignored in production builds)
NEXT_PUBLIC_SHOW_DEV_FIXTURES=
NEXT_PUBLIC_SHOW_CANDIDATE_PRICES=
